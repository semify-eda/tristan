// DESCRIPTION: Verilator config file
// Suppress warnings from upstream CVA6 IP and vendor libraries.
// These are third-party files we do not own and cannot fix.
// Warnings in our own files (core/custom/*, core/include/*, etc.) are NOT suppressed.
`verilator_config

lint_off -rule TIMESCALEMOD   -file "*/cva6/*"
lint_off -rule SELRANGE       -file "*/cva6/*"
lint_off -rule WIDTHTRUNC     -file "*/cva6/*"
lint_off -rule WIDTHEXPAND    -file "*/cva6/*"
lint_off -rule LATCH          -file "*/cva6/*"
lint_off -rule UNOPTFLAT      -file "*/cva6/*"
lint_off -rule CASEINCOMPLETE -file "*/cva6/*"
lint_off -rule UNSIGNED       -file "*/cva6/*"
lint_off -rule WIDTHCONCAT    -file "*/cva6/*"
lint_off -rule SYMRSVDWORD    -file "*/cva6/*"
lint_off -rule IMPLICIT       -file "*/cva6/*"
lint_off -rule IMPLICITSTATIC -file "*/cva6/*"
